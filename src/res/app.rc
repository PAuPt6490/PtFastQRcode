#include <windows.h>
#include "resource.h"

IDI_APP ICON "..\\..\\assets\\app.ico"

1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "FileDescription", "PtFastQRcode - quick QR code generator"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "PtFastQRcode"
            VALUE "OriginalFilename", "PtFastQRcode.exe"
            VALUE "ProductName", "PtFastQRcode"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
